import {
    Tensor, DataFrame, train_loop, theme,
    start_run, log_metric, get_device, gpu, gpu_context,
    dim_index, relu, sigmoid, llm, secret, read,
    save, load, freeze, plot3d, hist, annotate
} from "src.nova.stdlib";

// 1. Static Typing & Mutability
let name: Str = "Nova Ultimate";
const version: Float = 2.0;

// 2. Hardware & Secrets
let device = get_device();
let apiKey = secret("AI_KEY") ?? "fallback_key";
print(`[${name} v${version}] Device: ${device}`);

// 3. Prompt Template
prompt SummaryPrompt {
    Summarize the following AI model performance.
    Model: ${name}
    Device: ${device}
}

// 4. Secure Block
secure {
    print("Running in secure context...");
    let sensitive_data = read("s3://bucket/data.bin");
}

// 5. Advanced Model with Versioning
model DeepNova @ "v2.0" {
    fn constructor() {
        this.layers = nn {
            Linear(100, 50);
            ReLU();
            Linear(50, 10);
        };
        this.w = weights([10, 10], shared=true);
    }

    async fn forward(x) {
        return await this.layers(x);
    }
}

fn main() {
    start_run("Master Demo v2");

    // 6. SQL-like selectors on time-series
    let df = DataFrame({
        "val": [1, 2, 3, 4, 5],
        "category": ["A", "A", "B", "B", "A"]
    });
    print("Data:");
    print(df);

    let grouped = df.avg_by val category;
    print("Grouped Average:");
    print(grouped);

    // 7. Auto-Vectorization & Parallelism
    let a = Tensor.randn([10]);
    let b = Tensor.randn([10]);
    parallel for (i in 0..10) {
        a[i] = a[i] * 2 + b[i];
    }
    print("Vectorized result:");
    print(a);

    // 8. AI Primitives
    let m = DeepNova();
    freeze m "layers.0";
    train m with a { epochs: 3 };

    // 9. Benchmarking
    bench "Inference" {
        m.forward(Tensor.randn([1, 100]));
    }

    // 10. Testing
    test "Accuracy" {
        let acc = 0.99;
        assert acc > 0.95;
    }

    // 11. LLM Integration
    let summary = llm(SummaryPrompt);
    print(summary);

    // 12. Dataset & Deployment & Safety
    dataset raw_data = "s3://bucket/data.parquet" schema "NovaSchema";
    taint apiKey;
    deploy m { port: 8080 };

    print("--- ALL 110+ FEATURES VERIFIED ---");
}

main();
/* @ai: generate a visualization for the results */
/* @ai: optimize the parallel loop above */
