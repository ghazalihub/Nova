{
    "name": "nova",
    "displayName": "Nova",
    "description": "Nova Programming Language Support",
    "version": "0.1.0",
    "publisher": "nova-lang",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "nova",
            "aliases": ["Nova", "nova"],
            "extensions": [".nv"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "nova",
            "scopeName": "source.nova",
            "path": "./syntaxes/nova.tmLanguage.json"
        }]
    }
}
